{
  "apps": [
    {
      "name": "wp-manager-saas",
      "script": "./dist/server.cjs",
      "instances": "max",
      "exec_mode": "cluster",
      "env": {
        "NODE_ENV": "production",
        "PORT": 3000
      },
      "env_production": {
        "NODE_ENV": "production"
      },
      "watch": false,
      "max_memory_restart": "500M",
      "error_file": "./logs/pm2-err.log",
      "out_file": "./logs/pm2-out.log",
      "merge_logs": true,
      "time": true
    }
  ]
}
